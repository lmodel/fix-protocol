	skos:inScheme fix_protocol:schema\/fix_protocol_core .
fix_protocol:discriminator_field dcterms:title "Discriminator Field" ;
	a owl:ObjectProperty ;
	rdfs:label "discriminator_field" ;
	skos:altLabel "discriminatorId" ;
	skos:definition "The field whose value says how to read this field's value." ;
	skos:exactMatch fixr:discriminatorId ;
	skos:inScheme fix_protocol:schema\/fix_protocol_dictionary .
fix_protocol:field_code_set dcterms:title "Code Set" ;
	a owl:ObjectProperty ;
	rdfs:label "field_code_set" ;
	skos:altLabel "type" ;
	skos:definition "The code set that lists the field's values." ;
	skos:exactMatch fixr:type ;
	skos:inScheme fix_protocol:schema\/fix_protocol_dictionary .
fix_protocol:field_datatype dcterms:title "Datatype" ;
	a owl:ObjectProperty ;
	rdfs:label "field_datatype" ;
	skos:altLabel "type" ;
	skos:definition "The datatype of the field's values, when no code set lists them." ;
	skos:exactMatch fixr:type ;
	skos:inScheme fix_protocol:schema\/fix_protocol_dictionary .
fix_protocol:fix_categories dcterms:title "Categories" ;
	a owl:ObjectProperty ;
	rdfs:label "fix_categories" ;
	skos:altLabel "categories" ;
	skos:definition "The categories, in FIX's order." ;
	skos:inScheme <https://w3id.org/lmodel/fix-protocol> .
fix_protocol:fix_code_sets dcterms:title "Code Sets" ;
	a owl:ObjectProperty ;
	rdfs:label "fix_code_sets" ;
	skos:altLabel "codeSets" ;
	skos:definition "The code sets, in FIX's order." ;
	skos:inScheme <https://w3id.org/lmodel/fix-protocol> .
fix_protocol:fix_codes dcterms:title "Codes" ;
	a owl:ObjectProperty ;
	rdfs:label "fix_codes" ;
	skos:altLabel "code" ;
	skos:definition "The codes of the set, in FIX's order." ;
	skos:exactMatch fixr:code ;
	skos:inScheme fix_protocol:schema\/fix_protocol_dictionary .
fix_protocol:fix_components dcterms:title "Components" ;
	a owl:ObjectProperty ;
	rdfs:label "fix_components" ;
	skos:altLabel "components" ;
	skos:definition "The components, in FIX's order." ;
	skos:inScheme <https://w3id.org/lmodel/fix-protocol> .
fix_protocol:fix_datatypes dcterms:title "Datatypes" ;
	a owl:ObjectProperty ;
	rdfs:label "fix_datatypes" ;
	skos:altLabel "datatypes" ;
	skos:definition "The datatypes, in FIX's order." ;
	skos:inScheme <https://w3id.org/lmodel/fix-protocol> .
fix_protocol:fix_fields dcterms:title "Fields" ;

@prefix fixr: <http://fixprotocol.io/2020/orchestra/repository/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix fix_orchestra: <https://w3id.org/lmodel/fix-orchestra/> .
@prefix fix_protocol: <https://w3id.org/lmodel/fix-protocol/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix pav: <http://purl.org/pav/> .
xsd:date a rdfs:Datatype ;
	owl:equivalentClass _:c14n199 .
xsd:integer a rdfs:Datatype ;
	owl:equivalentClass _:c14n82 .
xsd:string a rdfs:Datatype ;
	owl:equivalentClass _:c14n363 , _:c14n365 .
<https://w3id.org/lmodel/fix-protocol.owl.ttl> dcterms:license "Apache-2.0" ;
	dcterms:source <https://github.com/FIXTradingCommunity/orchestrations/blob/cd24169a2abd8daba7c360987c7a46ca11873a12/FIX%20Standard/OrchestraFIXLatest.xml> ;
	dcterms:title "FIX Latest" ;
	pav:version "FIX.Latest_EP312" ;
	<http://schema.org/keywords> "FIX Latest" , "FIX" , "Orchestra" , "financial messaging" , "trading" ;
	a owl:Ontology ;
	rdfs:label "fix_protocol" ;
	rdfs:seeAlso <https://github.com/FIXTradingCommunity/orchestrations> , <https://lmodel.github.io/fix-protocol> ;
	skos:definition "A LinkML model of FIX Latest, the application layer of the Financial Information eXchange (FIX) protocol that the FIX Trading Community maintains. It holds every section, category, datatype, code set, field, component, repeating group and message of FIX Latest as a record, with the version and extension pack that added and last changed each one. The records keep FIX's names, numbers and codes and none of its descriptive text." ;
	skos:note "The version is the extension pack the catalogue renders. upstream/ holds FIX Latest's Orchestra file unchanged, scripts/fix_latest_to_records.py writes the catalogue from it, and scripts/check_upstream_release.py reports when FIX publishes another." ;
	fix_protocol:upstream_commit "cd24169a2abd8daba7c360987c7a46ca11873a12" ;
	fix_protocol:upstream_created "2026-09-08" ;
	fix_protocol:upstream_license "Apache-2.0" ;
	fix_protocol:upstream_repository "https://github.com/FIXTradingCommunity/orchestrations" .
fix_protocol:FixCategory dcterms:title "Category" ;
	a owl:Class ;
	rdfs:label "FixCategory" ;
	rdfs:subClassOf fix_protocol:FixElement , _:c14n100 , _:c14n105 , _:c14n109 , _:c14n11 , _:c14n116 , _:c14n179 , _:c14n19 , _:c14n191 , _:c14n194 , _:c14n206 , _:c14n212 , _:c14n237 , _:c14n238 , _:c14n252 , _:c14n76 , _:c14n80 , _:c14n92 , _:c14n96 ;
	skos:definition "A group of messages within a section, or one of the groups that hold the shared components and the fields." ;
	skos:exactMatch fixr:categoryType , fix_orchestra:OrchestraCategoryV10 ;
	skos:inScheme fix_protocol:schema\/fix_protocol_core .
fix_protocol:FixCategoryKind\#Field dcterms:title "Fields" ;
	a owl:Class ;
	rdfs:label "Field" ;
	rdfs:subClassOf fix_protocol:FixCategoryKind ;
	skos:definition "The category groups fields." .
fix_protocol:FixCategoryKind\#Message dcterms:title "Messages" ;
	a owl:Class ;
	rdfs:label "Message" ;
	rdfs:subClassOf fix_protocol:FixCategoryKind ;
	skos:definition "The category groups messages and their components." .
fix_protocol:FixCategoryKind dcterms:title "Category Kind" ;
	a owl:Class ;
	rdfs:label "FixCategoryKind" ;
	owl:unionOf _:c14n48 ;
	skos:definition "Whether a category groups messages or fields." ;
	skos:inScheme fix_protocol:schema\/fix_protocol_core ;
	linkml:permissible_values fix_protocol:FixCategoryKind\#Field , fix_protocol:FixCategoryKind\#Message .
fix_protocol:FixCode dcterms:title "Code" ;
	a owl:Class ;
	rdfs:label "FixCode" ;
	rdfs:subClassOf fix_protocol:FixElement , _:c14n12 , _:c14n124 , _:c14n168 , _:c14n190 , _:c14n239 , _:c14n262 , _:c14n265 , _:c14n270 , _:c14n39 , _:c14n7 , _:c14n81 , _:c14n88 ;
	skos:definition "One value of a code set, with its name, such as 1 for Buy." ;
	skos:exactMatch fixr:codeType , fix_orchestra:OrchestraCodeV10 ;
	skos:inScheme fix_protocol:schema\/fix_protocol_dictionary .
fix_protocol:FixCodeSet dcterms:title "Code Set" ;
	a owl:Class ;
	rdfs:label "FixCodeSet" ;
	rdfs:subClassOf fix_protocol:FixElement , _:c14n142 , _:c14n154 , _:c14n159 , _:c14n184 , _:c14n187 , _:c14n230 , _:c14n272 , _:c14n77 ;
	skos:definition "A list of the values a field may take, each a code with a name, such as the sides of an order." ;
	skos:exactMatch fixr:codeSetType , fix_orchestra:OrchestraCodeSetV10 ;
	skos:inScheme fix_protocol:schema\/fix_protocol_dictionary .
fix_protocol:FixComponent dcterms:title "Component" ;
	a owl:Class ;
	rdfs:label "FixComponent" ;
	rdfs:subClassOf fix_protocol:FixElement , _:c14n110 , _:c14n123 , _:c14n145 , _:c14n169 , _:c14n185 , _:c14n186 , _:c14n250 , _:c14n253 , _:c14n257 , _:c14n277 , _:c14n3 , _:c14n45 , _:c14n63 , _:c14n74 ;
	skos:definition "A named block of fields, components and groups that messages share, such as Instrument." ;
	skos:exactMatch fixr:componentType , fix_orchestra:OrchestraComponentV10 ;
	skos:inScheme fix_protocol:schema\/fix_protocol_structure .
fix_protocol:FixDatatype dcterms:title "Datatype" ;
	a owl:Class ;
	rdfs:label "FixDatatype" ;
	rdfs:subClassOf fix_protocol:FixElement , _:c14n148 , _:c14n150 , _:c14n152 , _:c14n176 , _:c14n193 , _:c14n204 , _:c14n275 , _:c14n54 ;
	skos:definition "A kind of value a field holds, such as int, Price or UTCTimestamp, with the XML Schema types it maps to." ;
	skos:exactMatch fixr:datatype , fix_orchestra:OrchestraDatatypeV10 ;
	skos:inScheme fix_protocol:schema\/fix_protocol_dictionary .
fix_protocol:FixElement dcterms:title "FIX Element" ;
	a owl:Class ;
	rdfs:label "FixElement" ;
	rdfs:subClassOf fix_protocol:FixPedigreeMixin , _:c14n157 , _:c14n183 , _:c14n223 , _:c14n232 , _:c14n60 , _:c14n90 , _:c14n98 ;
	skos:definition "An element of FIX Latest with an identifier and a name of its own." ;
	skos:inScheme fix_protocol:schema\/fix_protocol_core .
fix_protocol:FixField dcterms:title "Field" ;
	a owl:Class ;
	rdfs:label "FixField" ;
	rdfs:subClassOf fix_protocol:FixElement , _:c14n1 , _:c14n106 , _:c14n108 , _:c14n136 , _:c14n140 , _:c14n15 , _:c14n155 , _:c14n167 , _:c14n18 , _:c14n213 , _:c14n216 , _:c14n234 , _:c14n24 , _:c14n244 , _:c14n245 , _:c14n246 , _:c14n251 , _:c14n264 , _:c14n27 , _:c14n279 , _:c14n32 , _:c14n35 , _:c14n42 , _:c14n51 , _:c14n58 , _:c14n62 , _:c14n64 , _:c14n70 , _:c14n94 , _:c14n99 ;
	owl:disjointUnionOf _:c14n56 ;
	skos:definition "A field of FIX, known by its tag number, such as 55 for Symbol, with the datatype or code set of its values." ;
	skos:exactMatch fixr:fieldType , fix_orchestra:OrchestraFieldV10 ;
	skos:inScheme fix_protocol:schema\/fix_protocol_dictionary ;
	skos:note "FIX Latest names a field's datatype or code set in one attribute, type. The record splits it, so each reference has one range, as Orchestra 1.1 does." .
fix_protocol:FixGroup dcterms:title "Repeating Group" ;
	a owl:Class ;
	rdfs:label "FixGroup" ;
	rdfs:subClassOf fix_protocol:FixElement , _:c14n119 , _:c14n147 , _:c14n181 , _:c14n195 , _:c14n21 , _:c14n221 , _:c14n235 , _:c14n268 , _:c14n273 , _:c14n274 , _:c14n69 , _:c14n79 , _:c14n9 , _:c14n93 ;
	skos:definition "A block of members that repeats in a message, with the field that counts the repeats." ;
	skos:exactMatch fixr:groupType , fix_orchestra:OrchestraGroupV10 ;
	skos:inScheme fix_protocol:schema\/fix_protocol_structure .
fix_protocol:FixIncludeFile\#components dcterms:title "Components" ;
	a owl:Class ;
	rdfs:label "components" ;
	rdfs:subClassOf fix_protocol:FixIncludeFile ;
	skos:definition "The file that defines the shared components." .
fix_protocol:FixIncludeFile\#fields dcterms:title "Fields" ;
	a owl:Class ;
	rdfs:label "fields" ;
	rdfs:subClassOf fix_protocol:FixIncludeFile ;
	skos:definition "The file that defines the fields." .
fix_protocol:FixIncludeFile dcterms:title "Included FIXML File" ;
	a owl:Class ;
	rdfs:label "FixIncludeFile" ;
	owl:unionOf _:c14n117 ;
	skos:definition "Which shared FIXML schema file a category's own FIXML schema file brings in." ;
	skos:inScheme fix_protocol:schema\/fix_protocol_core ;
	linkml:permissible_values fix_protocol:FixIncludeFile\#components , fix_protocol:FixIncludeFile\#fields .
fix_protocol:FixMappedDatatype dcterms:title "Mapped Datatype" ;
	a owl:Class ;
	rdfs:label "FixMappedDatatype" ;
	rdfs:subClassOf _:c14n121 , _:c14n137 , _:c14n138 , _:c14n173 , _:c14n182 , _:c14n229 , _:c14n248 , _:c14n254 , _:c14n260 , _:c14n281 , _:c14n50 , _:c14n53 , _:c14n61 , _:c14n78 , _:c14n91 ;
	skos:definition "The type of another standard that a FIX datatype takes, such as xs:decimal in XML Schema." ;
	skos:exactMatch fixr:mappedDatatype ;
	skos:inScheme fix_protocol:schema\/fix_protocol_dictionary .
fix_protocol:FixMember dcterms:title "Member" ;
	a owl:Class ;
	rdfs:label "FixMember" ;
	rdfs:subClassOf fix_protocol:FixPedigreeMixin , _:c14n107 , _:c14n133 , _:c14n16 , _:c14n163 , _:c14n17 , _:c14n210 , _:c14n236 , _:c14n26 , _:c14n267 , _:c14n30 , _:c14n49 , _:c14n66 , _:c14n73 , _:c14n95 , _:c14n97 ;
	owl:disjointUnionOf _:c14n164 ;
	skos:definition "One field, component or group in a message, component or group, and whether it must be there." ;
	skos:exactMatch fixr:componentRefType , fixr:fieldRefType , fixr:groupRefType ;
	skos:inScheme fix_protocol:schema\/fix_protocol_structure ;
	skos:note "Orchestra gives the three kinds of member three elements of one shape. The record gives each a key, and one member holds exactly one of them." .
fix_protocol:FixMessage dcterms:title "Message" ;
	a owl:Class ;
	rdfs:label "FixMessage" ;
	rdfs:subClassOf fix_protocol:FixElement , _:c14n101 , _:c14n135 , _:c14n139 , _:c14n177 , _:c14n201 , _:c14n22 , _:c14n220 , _:c14n231 , _:c14n241 , _:c14n280 , _:c14n29 , _:c14n34 , _:c14n4 , _:c14n47 , _:c14n5 , _:c14n86 , _:c14n89 ;
	skos:definition "A FIX message, known by its MsgType, such as D for NewOrderSingle, with its members in order." ;
	skos:exactMatch fixr:messageType , fix_orchestra:OrchestraMessageV10 ;
	skos:inScheme fix_protocol:schema\/fix_protocol_structure .
fix_protocol:FixNumInGroup dcterms:title "Count Field Reference" ;
	a owl:Class ;
	rdfs:label "FixNumInGroup" ;
	rdfs:subClassOf fix_protocol:FixPedigreeMixin , _:c14n20 , _:c14n59 , _:c14n87 ;
	skos:definition "The field that counts a group's repeats, as the group names it." ;
	skos:exactMatch fixr:numInGroupType ;
	skos:inScheme fix_protocol:schema\/fix_protocol_structure .
fix_protocol:FixPedigreeMixin dcterms:title "Pedigree" ;
	a owl:Class ;
	rdfs:label "FixPedigreeMixin" ;
	rdfs:subClassOf _:c14n10 , _:c14n111 , _:c14n122 , _:c14n125 , _:c14n131 , _:c14n144 , _:c14n160 , _:c14n171 , _:c14n197 , _:c14n198 , _:c14n207 , _:c14n225 , _:c14n23 , _:c14n233 , _:c14n242 , _:c14n266 , _:c14n269 , _:c14n271 ;
	skos:definition "When FIX added, last changed and deprecated an element, by version and extension pack." ;
	skos:inScheme fix_protocol:schema\/fix_protocol_core .
fix_protocol:FixPresence\#constant dcterms:title "Constant" ;
	a owl:Class ;
	rdfs:label "constant" ;
	rdfs:subClassOf fix_protocol:FixPresence ;
	skos:definition "The member always takes one fixed value." .
fix_protocol:FixPresence\#forbidden dcterms:title "Forbidden" ;
	a owl:Class ;
	rdfs:label "forbidden" ;
	rdfs:subClassOf fix_protocol:FixPresence ;
	skos:definition "The member must be left out." .
fix_protocol:FixPresence\#ignored dcterms:title "Ignored" ;
	a owl:Class ;
	rdfs:label "ignored" ;
	rdfs:subClassOf fix_protocol:FixPresence ;
	skos:definition "A receiver disregards the member if it is there." .
fix_protocol:FixPresence\#optional dcterms:title "Optional" ;
	a owl:Class ;
	rdfs:label "optional" ;
	rdfs:subClassOf fix_protocol:FixPresence ;
	skos:definition "The member may be left out." .
fix_protocol:FixPresence\#required dcterms:title "Required" ;
	a owl:Class ;
	rdfs:label "required" ;
	rdfs:subClassOf fix_protocol:FixPresence ;
	skos:definition "The member must be there." .
fix_protocol:FixPresence dcterms:title "Presence" ;
	a owl:Class ;
	rdfs:label "FixPresence" ;
	owl:unionOf _:c14n205 ;
	skos:definition "Whether a message, component or group must carry a member, as Orchestra 1.0 lets FIX Latest say it." ;
	skos:inScheme fix_protocol:schema\/fix_protocol_core ;
	skos:note "FIX Latest states only required. A member with no presence is optional, which is Orchestra 1.0's default." ;
	linkml:permissible_values fix_protocol:FixPresence\#constant , fix_protocol:FixPresence\#forbidden , fix_protocol:FixPresence\#ignored , fix_protocol:FixPresence\#optional , fix_protocol:FixPresence\#required .
fix_protocol:FixRepository dcterms:title "FIX Latest Catalogue" ;
	a owl:Class ;
	rdfs:label "FixRepository" ;
	rdfs:subClassOf _:c14n0 , _:c14n102 , _:c14n104 , _:c14n112 , _:c14n113 , _:c14n114 , _:c14n115 , _:c14n126 , _:c14n127 , _:c14n129 , _:c14n13 , _:c14n132 , _:c14n14 , _:c14n141 , _:c14n146 , _:c14n153 , _:c14n158 , _:c14n161 , _:c14n170 , _:c14n172 , _:c14n175 , _:c14n180 , _:c14n192 , _:c14n196 , _:c14n2 , _:c14n202 , _:c14n203 , _:c14n208 , _:c14n209 , _:c14n215 , _:c14n217 , _:c14n219 , _:c14n222 , _:c14n226 , _:c14n228 , _:c14n240 , _:c14n249 , _:c14n25 , _:c14n255 , _:c14n256 , _:c14n276 , _:c14n278 , _:c14n28 , _:c14n31 , _:c14n36 , _:c14n38 , _:c14n44 , _:c14n57 , _:c14n6 ;
	skos:definition "One file of the catalogue: the edition it renders and one or more kinds of FIX Latest's elements." ;
	skos:exactMatch fixr:repository , fix_orchestra:OrchestraRepositoryV10 ;
	skos:inScheme <https://w3id.org/lmodel/fix-protocol> .
fix_protocol:FixSection dcterms:title "Section" ;
	a owl:Class ;
	rdfs:label "FixSection" ;
	rdfs:subClassOf fix_protocol:FixElement , _:c14n134 , _:c14n151 , _:c14n178 , _:c14n188 , _:c14n243 , _:c14n259 , _:c14n33 , _:c14n40 , _:c14n41 , _:c14n65 , _:c14n71 , _:c14n8 ;
	skos:definition "One of the five parts of FIX by business area, such as pre-trade or post-trade." ;
	skos:exactMatch fixr:sectionType , fix_orchestra:OrchestraSectionV10 ;
	skos:inScheme fix_protocol:schema\/fix_protocol_core .
fix_protocol:abbr_name dcterms:title "Abbreviated Name" ;
	a owl:DatatypeProperty ;
	rdfs:label "abbr_name" ;
	rdfs:range xsd:string ;
	skos:altLabel "abbrName" ;
	skos:definition "The shorter name FIXML uses for the element's tag." ;
	skos:exactMatch fixr:abbrName ;
	skos:inScheme fix_protocol:schema\/fix_protocol_core .
fix_protocol:added_in dcterms:title "Added In" ;
	a owl:DatatypeProperty ;
	rdfs:label "added_in" ;
	rdfs:range xsd:string ;
	skos:altLabel "added" ;
	skos:definition "The FIX version that added the element." ;
	skos:exactMatch fixr:added ;
	skos:inScheme fix_protocol:schema\/fix_protocol_core .
fix_protocol:added_in_ep dcterms:title "Added In Extension Pack" ;
	a owl:DatatypeProperty ;
	rdfs:label "added_in_ep" ;
	rdfs:range xsd:integer ;
	skos:altLabel "addedEP" ;
	skos:definition "The extension pack that added the element." ;
	skos:exactMatch fixr:addedEP ;
	skos:inScheme fix_protocol:schema\/fix_protocol_core .
fix_protocol:base_category dcterms:title "Base Category" ;
	a owl:ObjectProperty ;
	rdfs:label "base_category" ;
	skos:altLabel "baseCategory" ;
	skos:definition "The category whose FIXML element carries the field under the short name base_category_abbr_name gives." ;
	skos:exactMatch fixr:baseCategory ;
	skos:inScheme fix_protocol:schema\/fix_protocol_dictionary .
fix_protocol:base_category_abbr_name dcterms:title "Base Category Abbreviated Name" ;
	a owl:DatatypeProperty ;
	rdfs:label "base_category_abbr_name" ;
	skos:altLabel "baseCategoryAbbrName" ;
	skos:definition "The field's short name within its base category's FIXML element." ;
	skos:exactMatch fixr:baseCategoryAbbrName ;
	skos:inScheme fix_protocol:schema\/fix_protocol_dictionary .
fix_protocol:base_type dcterms:title "Base Type" ;
	a owl:ObjectProperty ;
	rdfs:label "base_type" ;
	skos:altLabel "baseType" ;
	skos:definition "The datatype this one narrows." ;
	skos:exactMatch fixr:baseType ;
	skos:inScheme fix_protocol:schema\/fix_protocol_dictionary .
fix_protocol:category_kind dcterms:title "Category Kind" ;
	a owl:ObjectProperty ;
	rdfs:label "category_kind" ;
	skos:altLabel "componentType" ;
	skos:definition "Whether the category groups messages or fields." ;
	skos:exactMatch fixr:componentType ;
	skos:inScheme fix_protocol:schema\/fix_protocol_core .
fix_protocol:code_group dcterms:title "Code Group" ;
	a owl:DatatypeProperty ;
	rdfs:label "code_group" ;
	skos:altLabel "group" ;
	skos:definition "A label that groups some codes of a large set, such as one asset class." ;
	skos:exactMatch fixr:group ;
	skos:inScheme fix_protocol:schema\/fix_protocol_dictionary .
fix_protocol:code_set_datatype dcterms:title "Datatype" ;
	a owl:ObjectProperty ;
	rdfs:label "code_set_datatype" ;
	skos:altLabel "type" ;
	skos:definition "The datatype of the codes' values." ;
	skos:exactMatch fixr:type ;
	skos:inScheme fix_protocol:schema\/fix_protocol_dictionary .
fix_protocol:code_value dcterms:title "Value" ;
	a owl:DatatypeProperty ;
	rdfs:label "code_value" ;
	skos:altLabel "value" ;
	skos:definition "The value as it travels on the wire." ;
	skos:exactMatch fixr:value ;
	skos:inScheme fix_protocol:schema\/fix_protocol_dictionary .
fix_protocol:count_field dcterms:title "Field" ;
	a owl:ObjectProperty ;
	rdfs:label "count_field" ;
	skos:altLabel "id" ;
	skos:definition "The field that holds the count." ;
	skos:exactMatch fixr:id ;
	skos:inScheme fix_protocol:schema\/fix_protocol_structure .
fix_protocol:deprecated_in dcterms:title "Deprecated In" ;
	a owl:DatatypeProperty ;
	rdfs:label "deprecated_in" ;
	rdfs:range xsd:string ;
	skos:altLabel "deprecated" ;
	skos:definition "The FIX version that deprecated the element." ;
	skos:exactMatch fixr:deprecated ;
	skos:inScheme fix_protocol:schema\/fix_protocol_core .
fix_protocol:deprecated_in_ep dcterms:title "Deprecated In Extension Pack" ;
	a owl:DatatypeProperty ;
	rdfs:label "deprecated_in_ep" ;
	rdfs:range xsd:integer ;
	skos:altLabel "deprecatedEP" ;
	skos:definition "The extension pack that deprecated the element." ;

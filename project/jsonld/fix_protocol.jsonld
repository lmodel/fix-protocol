{
  "name": "fix_protocol",
  "annotations": [
    {
      "tag": "upstream_repository",
      "value": "https://github.com/FIXTradingCommunity/orchestrations"
    },
    {
      "tag": "upstream_commit",
      "value": "cd24169a2abd8daba7c360987c7a46ca11873a12"
    },
    {
      "tag": "upstream_created",
      "value": "2026-09-08"
    },
    {
      "tag": "upstream_license",
      "value": "Apache-2.0"
    }
  ],
  "description": "A LinkML model of FIX Latest, the application layer of the Financial Information eXchange (FIX) protocol that the FIX Trading Community maintains. It holds every section, category, datatype, code set, field, component, repeating group and message of FIX Latest as a record, with the version and extension pack that added and last changed each one. The records keep FIX's names, numbers and codes and none of its descriptive text.",
  "title": "FIX Latest",
  "comments": [
    "The version is the extension pack the catalogue renders. upstream/ holds FIX Latest's Orchestra file unchanged, scripts/fix_latest_to_records.py writes the catalogue from it, and scripts/check_upstream_release.py reports when FIX publishes another."
  ],
  "source": "https://github.com/FIXTradingCommunity/orchestrations/blob/cd24169a2abd8daba7c360987c7a46ca11873a12/FIX%20Standard/OrchestraFIXLatest.xml",
  "see_also": [
    "https://lmodel.github.io/fix-protocol",
    "https://github.com/FIXTradingCommunity/orchestrations"
  ],
  "keywords": [
    "FIX",
    "FIX Latest",
    "financial messaging",
    "trading",
    "Orchestra"
  ],
  "id": "https://w3id.org/lmodel/fix-protocol",
  "version": "FIX.Latest_EP312",
  "imports": [
    "linkml:types",
    "./fix_protocol_core",
    "./fix_protocol_dictionary",
    "./fix_protocol_structure"
  ],
  "license": "Apache-2.0",

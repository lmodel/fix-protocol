<https://w3id.org/lmodel/fix-protocol/fix_version> dcterms:title "FIX Version" ;
	a linkml:TypeDefinition ;
	skos:exactMatch "fixr:Version_t"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/fix-protocol/schema/fix_protocol_core"^^xsd:anyURI ;
	skos:note "The pattern is Orchestra 1.0's for a version, anchored at both ends." ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/fix-protocol/FixVersion"^^xsd:anyURI ;
	linkml:description "A FIX version, such as FIX.4.4, FIX.5.0SP2 or FIX.Latest." ;
	linkml:pattern "^(FIX\\.2\\.7|FIX\\.3\\.0|FIX\\.4\\.[0-4]|(FIX\\.Latest|FIX\\.5\\.0(SP[0-9]{1,2})?)(_EP(9[89]|[1-9][0-9]{2}))?|FIXT\\.1\\.1|[0-9]+\\.[0-9]+|[0-9]{8})$" ;
	linkml:typeof <https://w3id.org/lmodel/fix-protocol/string> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .

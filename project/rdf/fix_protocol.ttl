<https://w3id.org/lmodel/fix-protocol/fix_protocol> dcterms:license "Apache-2.0" ;
	dcterms:source "https://github.com/FIXTradingCommunity/orchestrations/blob/cd24169a2abd8daba7c360987c7a46ca11873a12/FIX%20Standard/OrchestraFIXLatest.xml"^^xsd:anyURI ;
	dcterms:title "FIX Latest" ;
	pav:version "FIX.Latest_EP312" ;
	schema1:keywords "FIX Latest" , "FIX" , "Orchestra" , "financial messaging" , "trading" ;
	a linkml:SchemaDefinition ;
	rdfs:seeAlso "https://github.com/FIXTradingCommunity/orchestrations"^^xsd:anyURI , "https://lmodel.github.io/fix-protocol"^^xsd:anyURI ;
	skos:note "The version is the extension pack the catalogue renders. upstream/ holds FIX Latest's Orchestra file unchanged, scripts/fix_latest_to_records.py writes the catalogue from it, and scripts/check_upstream_release.py reports when FIX publishes another." ;
	sh:declare _:c14n12 , _:c14n13 , _:c14n14 , _:c14n17 , _:c14n18 , _:c14n19 , _:c14n20 , _:c14n21 , _:c14n23 , _:c14n25 , _:c14n26 , _:c14n3 , _:c14n5 , _:c14n6 , _:c14n9 ;
	linkml:annotations _:c14n1 , _:c14n27 , _:c14n32 , _:c14n8 ;
	linkml:classes <https://w3id.org/lmodel/fix-protocol/FixCategory> , <https://w3id.org/lmodel/fix-protocol/FixCode> , <https://w3id.org/lmodel/fix-protocol/FixCodeSet> , <https://w3id.org/lmodel/fix-protocol/FixComponent> , <https://w3id.org/lmodel/fix-protocol/FixDatatype> , <https://w3id.org/lmodel/fix-protocol/FixElement> , <https://w3id.org/lmodel/fix-protocol/FixField> , <https://w3id.org/lmodel/fix-protocol/FixGroup> , <https://w3id.org/lmodel/fix-protocol/FixMappedDatatype> , <https://w3id.org/lmodel/fix-protocol/FixMember> , <https://w3id.org/lmodel/fix-protocol/FixMessage> , <https://w3id.org/lmodel/fix-protocol/FixNumInGroup> , <https://w3id.org/lmodel/fix-protocol/FixPedigreeMixin> , <https://w3id.org/lmodel/fix-protocol/FixRepository> , <https://w3id.org/lmodel/fix-protocol/FixSection> ;
	linkml:default_prefix "fix_protocol" ;
	linkml:default_range <https://w3id.org/lmodel/fix-protocol/string> ;
	linkml:description "A LinkML model of FIX Latest, the application layer of the Financial Information eXchange (FIX) protocol that the FIX Trading Community maintains. It holds every section, category, datatype, code set, field, component, repeating group and message of FIX Latest as a record, with the version and extension pack that added and last changed each one. The records keep FIX's names, numbers and codes and none of its descriptive text." ;
	linkml:enums <https://w3id.org/lmodel/fix-protocol/FixCategoryKind> , <https://w3id.org/lmodel/fix-protocol/FixIncludeFile> , <https://w3id.org/lmodel/fix-protocol/FixPresence> ;
	linkml:id "https://w3id.org/lmodel/fix-protocol"^^xsd:anyURI ;
	linkml:imports "./fix_protocol_core"^^xsd:anyURI , "./fix_protocol_dictionary"^^xsd:anyURI , "./fix_protocol_structure"^^xsd:anyURI , "linkml:types"^^xsd:anyURI ;
	linkml:metamodel_version "1.12.0" ;

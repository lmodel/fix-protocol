	skos:inScheme "https://w3id.org/lmodel/fix-protocol/schema/fix_protocol_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/fix-protocol/fixml_file_name"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/fix-protocol/fixml_file_name"^^xsd:anyURI ;
	linkml:description "The FIXML schema file that holds the section's or category's elements, by its file name." ;
	linkml:domain_of <https://w3id.org/lmodel/fix-protocol/FixCategory> , <https://w3id.org/lmodel/fix-protocol/FixSection> ;
	linkml:owner <https://w3id.org/lmodel/fix-protocol/FixCategory> ;
	linkml:range <https://w3id.org/lmodel/fix-protocol/fix_name> ;
	linkml:slot_uri "https://w3id.org/lmodel/fix-protocol/fixml_file_name"^^xsd:anyURI .
<https://w3id.org/lmodel/fix-protocol/fixml_inlined> dcterms:title "Inlined in FIXML" ;
	a linkml:SlotDefinition ;
	skos:altLabel "inlined" ;
	linkml:description "True when FIXML writes the component's fields directly in the enclosing element rather than in an element of its own." ;
	linkml:range <https://w3id.org/lmodel/fix-protocol/boolean> .
<https://w3id.org/lmodel/fix-protocol/fixml_not_required> dcterms:title "Not Required in FIXML" ;
	a linkml:SlotDefinition ;
	skos:altLabel "notReqXML" ;
	skos:inScheme "https://w3id.org/lmodel/fix-protocol/schema/fix_protocol_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/fix-protocol/fixml_not_required"^^xsd:anyURI ;
	skos:note "FIX Latest writes it in a FIXML annotation, the only kind of application information the file carries." ;
	linkml:definition_uri "https://w3id.org/lmodel/fix-protocol/fixml_not_required"^^xsd:anyURI ;
	linkml:description "True when the element is left out of FIXML, FIX's XML encoding." ;
	linkml:domain_of <https://w3id.org/lmodel/fix-protocol/FixCategory> , <https://w3id.org/lmodel/fix-protocol/FixComponent> , <https://w3id.org/lmodel/fix-protocol/FixField> , <https://w3id.org/lmodel/fix-protocol/FixMessage> , <https://w3id.org/lmodel/fix-protocol/FixSection> ;
	linkml:owner <https://w3id.org/lmodel/fix-protocol/FixMessage> ;
	linkml:range <https://w3id.org/lmodel/fix-protocol/boolean> ;
	linkml:slot_uri "https://w3id.org/lmodel/fix-protocol/fixml_not_required"^^xsd:anyURI .
<https://w3id.org/lmodel/fix-protocol/float> a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"float\"." ;
	skos:exactMatch "schema:Float"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "float" ;
	linkml:definition_uri "https://w3id.org/linkml/Float"^^xsd:anyURI ;
	linkml:description "A real number that conforms to the xsd:float specification" ;
	linkml:imported_from "linkml:types" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#float"^^xsd:anyURI .
<https://w3id.org/lmodel/fix-protocol/forbidden> dcterms:title "Forbidden" ;
	linkml:description "The member must be left out." .
<https://w3id.org/lmodel/fix-protocol/id> dcterms:title "Identifier" ;
	a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/fix-protocol/schema/fix_protocol_core"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/fix-protocol/id"^^xsd:anyURI ;
	linkml:description "The element's identifier: a prefix for its kind, then the number or name FIX gives it, such as fix_field:55 or fix_category:Allocation." ;
	linkml:domain_of <https://w3id.org/lmodel/fix-protocol/FixElement> ;
	linkml:identifier true ;
	linkml:owner <https://w3id.org/lmodel/fix-protocol/FixElement> ;
	linkml:range <https://w3id.org/lmodel/fix-protocol/uriorcurie> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/fix-protocol/id"^^xsd:anyURI .
<https://w3id.org/lmodel/fix-protocol/ignored> dcterms:title "Ignored" ;
	linkml:description "A receiver disregards the member if it is there." .
<https://w3id.org/lmodel/fix-protocol/in_category> dcterms:title "Category" ;
	a linkml:SlotDefinition ;
	skos:altLabel "category" ;
	skos:exactMatch "http://fixprotocol.io/2020/orchestra/repository/category"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/fix-protocol/schema/fix_protocol_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/fix-protocol/in_category"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/fix-protocol/in_category"^^xsd:anyURI ;
	linkml:description "The category a message, component or group belongs to." ;
	linkml:domain_of <https://w3id.org/lmodel/fix-protocol/FixComponent> , <https://w3id.org/lmodel/fix-protocol/FixGroup> , <https://w3id.org/lmodel/fix-protocol/FixMessage> ;
	linkml:owner <https://w3id.org/lmodel/fix-protocol/FixMessage> ;
	linkml:pattern "^fix_category:[A-Za-z][A-Za-z0-9_]*$" ;
	linkml:range <https://w3id.org/lmodel/fix-protocol/FixCategory> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/fix-protocol/in_category"^^xsd:anyURI .
<https://w3id.org/lmodel/fix-protocol/in_section> dcterms:title "Section" ;
	a linkml:SlotDefinition ;
	skos:altLabel "section" ;
	skos:exactMatch "http://fixprotocol.io/2020/orchestra/repository/section"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/fix-protocol/schema/fix_protocol_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/fix-protocol/in_section"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/fix-protocol/in_section"^^xsd:anyURI ;
	linkml:description "The section a category belongs to." ;
	linkml:domain_of <https://w3id.org/lmodel/fix-protocol/FixCategory> ;
	linkml:owner <https://w3id.org/lmodel/fix-protocol/FixCategory> ;
	linkml:pattern "^fix_section:[A-Za-z][A-Za-z0-9_]*$" ;
	linkml:range <https://w3id.org/lmodel/fix-protocol/FixSection> ;
	linkml:slot_uri "https://w3id.org/lmodel/fix-protocol/in_section"^^xsd:anyURI .
<https://w3id.org/lmodel/fix-protocol/include_file> dcterms:title "Included FIXML File" ;
	a linkml:SlotDefinition ;
	skos:altLabel "includeFile" ;
	skos:exactMatch "fixr:includeFile"^^xsd:anyURI ;
	linkml:description "The shared FIXML schema file that the category's own FIXML schema file brings in." ;
	linkml:range <https://w3id.org/lmodel/fix-protocol/FixIncludeFile> .
<https://w3id.org/lmodel/fix-protocol/integer> a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"integer\"." ;
	skos:exactMatch "schema:Integer"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "int" ;
	linkml:definition_uri "https://w3id.org/linkml/Integer"^^xsd:anyURI ;
	linkml:description "An integer" ;
	linkml:imported_from "linkml:types" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#integer"^^xsd:anyURI .
<https://w3id.org/lmodel/fix-protocol/jsonpath> dcterms:conformsTo "https://www.ietf.org/archive/id/draft-goessner-dispatch-jsonpath-00.html" ;
	a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"jsonpath\"." ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/linkml/Jsonpath"^^xsd:anyURI ;
	linkml:description "A string encoding a JSON Path. The value of the string MUST conform to JSON Point syntax and SHOULD dereference to zero or more valid objects within the current instance document when encoded in tree form." ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/fix-protocol/jsonpointer> dcterms:conformsTo "https://datatracker.ietf.org/doc/html/rfc6901" ;
	a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"jsonpointer\"." ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/linkml/Jsonpointer"^^xsd:anyURI ;
	linkml:description "A string encoding a JSON Pointer. The value of the string MUST conform to JSON Point syntax and SHOULD dereference to a valid object within the current instance document when encoded in tree form." ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/fix-protocol/length_field> dcterms:title "Length Field" ;
	a linkml:SlotDefinition ;
	skos:altLabel "lengthId" ;
	skos:exactMatch "fixr:lengthId"^^xsd:anyURI ;
	linkml:description "The field that gives this field's length in bytes." ;
	linkml:pattern "^fix_field:[1-9][0-9]*$" ;
	linkml:range <https://w3id.org/lmodel/fix-protocol/FixField> .
<https://w3id.org/lmodel/fix-protocol/mapped_base> dcterms:title "Base" ;
	a linkml:SlotDefinition ;
	skos:altLabel "base" ;
	skos:exactMatch "fixr:base"^^xsd:anyURI ;
	linkml:description "The standard's type, such as xs:decimal." .
<https://w3id.org/lmodel/fix-protocol/mapped_builtin> dcterms:title "Built In" ;
	a linkml:SlotDefinition ;
	skos:altLabel "builtin" ;
	skos:exactMatch "fixr:builtin"^^xsd:anyURI ;
	linkml:description "True when the type is one the standard defines itself." ;
	linkml:range <https://w3id.org/lmodel/fix-protocol/boolean> .
<https://w3id.org/lmodel/fix-protocol/mapped_datatypes> dcterms:title "Mapped Datatypes" ;
	a linkml:SlotDefinition ;
	skos:altLabel "mappedDatatype" ;
	skos:exactMatch "fixr:mappedDatatype"^^xsd:anyURI ;
	linkml:description "The types of other standards that FIX gives as this datatype's form." ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/fix-protocol/FixMappedDatatype> .
<https://w3id.org/lmodel/fix-protocol/mapped_min_inclusive> dcterms:title "Least Value" ;
	a linkml:SlotDefinition ;
	skos:altLabel "minInclusive" ;
	skos:exactMatch "fixr:minInclusive"^^xsd:anyURI ;
	linkml:description "The smallest value the type allows, as FIX writes it." .
<https://w3id.org/lmodel/fix-protocol/mapped_pattern> dcterms:title "Pattern" ;
	a linkml:SlotDefinition ;
	skos:altLabel "pattern" ;
	skos:exactMatch "fixr:pattern"^^xsd:anyURI ;
	linkml:description "A regular expression in XML Schema's syntax that a value must match." .
<https://w3id.org/lmodel/fix-protocol/mapped_standard> dcterms:title "Standard" ;
	a linkml:SlotDefinition ;
	skos:altLabel "standard" ;
	skos:exactMatch "fixr:standard"^^xsd:anyURI ;
	linkml:description "The standard the type belongs to, such as XML." ;
	linkml:required true .
<https://w3id.org/lmodel/fix-protocol/member_component> dcterms:title "Component" ;
	a linkml:SlotDefinition ;
	skos:altLabel "componentRef" ;
	skos:exactMatch "fixr:componentRef"^^xsd:anyURI ;
	linkml:description "The component this member is." ;
	linkml:pattern "^fix_component:[1-9][0-9]*$" ;
	linkml:range <https://w3id.org/lmodel/fix-protocol/FixComponent> ;
	linkml:required true ;
	linkml:value_presence "ABSENT" .
<https://w3id.org/lmodel/fix-protocol/member_field> dcterms:title "Field" ;
	a linkml:SlotDefinition ;
	skos:altLabel "fieldRef" ;
	skos:exactMatch "fixr:fieldRef"^^xsd:anyURI ;
	linkml:description "The field this member is." ;
	linkml:pattern "^fix_field:[1-9][0-9]*$" ;
	linkml:range <https://w3id.org/lmodel/fix-protocol/FixField> ;
	linkml:required true ;
	linkml:value_presence "ABSENT" .
<https://w3id.org/lmodel/fix-protocol/member_group> dcterms:title "Group" ;
	a linkml:SlotDefinition ;
	skos:altLabel "groupRef" ;
	skos:exactMatch "fixr:groupRef"^^xsd:anyURI ;
	linkml:description "The repeating group this member is." ;
	linkml:pattern "^fix_group:[1-9][0-9]*$" ;
	linkml:range <https://w3id.org/lmodel/fix-protocol/FixGroup> ;
	linkml:required true ;
	linkml:value_presence "ABSENT" .
<https://w3id.org/lmodel/fix-protocol/metadata_conforms_to> dcterms:title "Conforms To" ;
	a linkml:SlotDefinition ;
	skos:altLabel "conformsTo" ;
	skos:exactMatch "dcterms:conformsTo"^^xsd:anyURI ;
	linkml:description "The Orchestra version the repository file follows." .
<https://w3id.org/lmodel/fix-protocol/metadata_created> dcterms:title "Created" ;
	a linkml:SlotDefinition ;
	skos:altLabel "created" ;
	skos:exactMatch "dcterms:created"^^xsd:anyURI ;
	linkml:description "The date the repository file was made." ;
	linkml:range <https://w3id.org/lmodel/fix-protocol/fix_date> .
<https://w3id.org/lmodel/fix-protocol/metadata_creator> dcterms:title "Creator" ;
	a linkml:SlotDefinition ;
	skos:altLabel "creator" ;
	skos:exactMatch "dcterms:creator"^^xsd:anyURI ;
	linkml:description "Who made the repository, as its metadata states." .
<https://w3id.org/lmodel/fix-protocol/metadata_description> dcterms:title "Edition Statement" ;
	a linkml:SlotDefinition ;
	skos:altLabel "description" ;
	skos:exactMatch "dcterms:description"^^xsd:anyURI ;
	linkml:description "The metadata's one-line statement of which extension pack the file holds." .
<https://w3id.org/lmodel/fix-protocol/metadata_format> dcterms:title "Format" ;
	a linkml:SlotDefinition ;
	skos:altLabel "format" ;
	skos:exactMatch "dcterms:format"^^xsd:anyURI ;
	linkml:description "The media type of the repository file." .
<https://w3id.org/lmodel/fix-protocol/metadata_publisher> dcterms:title "Publisher" ;
	a linkml:SlotDefinition ;
	skos:altLabel "publisher" ;
	skos:exactMatch "dcterms:publisher"^^xsd:anyURI ;
	linkml:description "Who published the repository, as its metadata states." .
<https://w3id.org/lmodel/fix-protocol/metadata_rights> dcterms:title "Rights Statement" ;
	a linkml:SlotDefinition ;
	skos:altLabel "rights" ;
	skos:exactMatch "dcterms:rights"^^xsd:anyURI ;
	linkml:description "The rights line in the repository's metadata, word for word." .
<https://w3id.org/lmodel/fix-protocol/metadata_source> dcterms:title "Source" ;
	a linkml:SlotDefinition ;
	skos:altLabel "source" ;
	skos:exactMatch "dcterms:source"^^xsd:anyURI ;
	linkml:description "The tool or source the metadata names for the file." .
<https://w3id.org/lmodel/fix-protocol/metadata_title> dcterms:title "Title" ;
	a linkml:SlotDefinition ;
	skos:altLabel "title" ;
	skos:exactMatch "dcterms:title"^^xsd:anyURI ;
	linkml:description "The title the repository's metadata gives." .
<https://w3id.org/lmodel/fix-protocol/msg_type> dcterms:title "MsgType" ;
	a linkml:SlotDefinition ;
	skos:altLabel "msgType" ;
	skos:exactMatch "fixr:msgType"^^xsd:anyURI ;
	linkml:description "The value of field 35 that marks a message of this kind." ;
	linkml:pattern "^[0-9A-Za-z]{1,2}$" ;
	linkml:required true .
<https://w3id.org/lmodel/fix-protocol/name> dcterms:title "Name" ;
	a linkml:SlotDefinition ;
	skos:altLabel "name" ;
	skos:exactMatch "http://fixprotocol.io/2020/orchestra/repository/name"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/fix-protocol/schema/fix_protocol_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/fix-protocol/name"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/fix-protocol/name"^^xsd:anyURI ;
	linkml:description "The element's name in FIX, such as NewOrderSingle or Symbol." ;
	linkml:domain_of <https://w3id.org/lmodel/fix-protocol/FixElement> ;
	linkml:owner <https://w3id.org/lmodel/fix-protocol/FixElement> ;
	linkml:range <https://w3id.org/lmodel/fix-protocol/fix_name> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/fix-protocol/name"^^xsd:anyURI .
<https://w3id.org/lmodel/fix-protocol/ncname> a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"ncname\"." ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "NCName" ;
	linkml:definition_uri "https://w3id.org/linkml/Ncname"^^xsd:anyURI ;
	linkml:description "Prefix part of CURIE" ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/fix-protocol/nodeidentifier> a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"nodeidentifier\"." ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "NodeIdentifier" ;
	linkml:definition_uri "https://w3id.org/linkml/Nodeidentifier"^^xsd:anyURI ;
	linkml:description "A URI, CURIE or BNODE that represents a node in a model." ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "http://www.w3.org/ns/shex#nonLiteral"^^xsd:anyURI .
<https://w3id.org/lmodel/fix-protocol/num_in_group> dcterms:title "Count Field" ;
	a linkml:SlotDefinition ;
	skos:altLabel "numInGroup" ;
	skos:exactMatch "fixr:numInGroup"^^xsd:anyURI ;
	linkml:description "The field that states how many times the group repeats." ;
	linkml:inlined true ;
	linkml:range <https://w3id.org/lmodel/fix-protocol/FixNumInGroup> ;
	linkml:required true .
<https://w3id.org/lmodel/fix-protocol/objectidentifier> a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"objectidentifier\"." ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	skos:note "Used for inheritance and type checking" ;
	linkml:base "ElementIdentifier" ;
	linkml:definition_uri "https://w3id.org/linkml/Objectidentifier"^^xsd:anyURI ;
	linkml:description "A URI or CURIE that represents an object in the model." ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "http://www.w3.org/ns/shex#iri"^^xsd:anyURI .
<https://w3id.org/lmodel/fix-protocol/optional> dcterms:title "Optional" ;
	linkml:description "The member may be left out." .
<https://w3id.org/lmodel/fix-protocol/presence> dcterms:title "Presence" ;
	a linkml:SlotDefinition ;
	skos:altLabel "presence" ;
	skos:exactMatch "fixr:presence"^^xsd:anyURI ;
	linkml:description "Whether the member must be there. A member that states none is optional." ;
	linkml:range <https://w3id.org/lmodel/fix-protocol/FixPresence> .
<https://w3id.org/lmodel/fix-protocol/repository_name> dcterms:title "Repository Name" ;
	a linkml:SlotDefinition ;
	skos:altLabel "name" ;
	skos:exactMatch "fixr:name"^^xsd:anyURI ;
	linkml:description "The name FIX gives the repository, FIX.Latest." ;
	linkml:equals_string "FIX.Latest" ;
	linkml:required true .
<https://w3id.org/lmodel/fix-protocol/repository_version> dcterms:title "Edition" ;
	a linkml:SlotDefinition ;
	skos:altLabel "version" ;
	skos:exactMatch "fixr:version"^^xsd:anyURI ;
	linkml:description "The extension pack the repository stands at, such as FIX.Latest_EP312." ;
	linkml:range <https://w3id.org/lmodel/fix-protocol/fix_version> ;
	linkml:required true .
<https://w3id.org/lmodel/fix-protocol/required> dcterms:title "Required" ;
	linkml:description "The member must be there." .
<https://w3id.org/lmodel/fix-protocol/section_order> dcterms:title "Display Order" ;
	a linkml:SlotDefinition ;
	skos:altLabel "displayOrder" ;
	skos:exactMatch "fixr:displayOrder"^^xsd:anyURI ;
	linkml:description "Where the section comes in FIX's own order of sections, counting from 0." ;
	linkml:minimum_value "0"^^linkml:\@id ;
	linkml:range <https://w3id.org/lmodel/fix-protocol/integer> .
<https://w3id.org/lmodel/fix-protocol/sort_order> dcterms:title "Sort Order" ;
	a linkml:SlotDefinition ;
	skos:altLabel "sort" ;
	skos:exactMatch "fixr:sort"^^xsd:anyURI ;
	linkml:description "Where the code comes when FIX lists the set." ;
	linkml:minimum_value "0"^^linkml:\@id ;
	linkml:range <https://w3id.org/lmodel/fix-protocol/integer> .
<https://w3id.org/lmodel/fix-protocol/sparqlpath> dcterms:conformsTo "https://www.w3.org/TR/sparql11-query/#propertypaths" ;
	a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"sparqlpath\"." ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/linkml/Sparqlpath"^^xsd:anyURI ;
	linkml:description "A string encoding a SPARQL Property Path. The value of the string MUST conform to SPARQL syntax and SHOULD dereference to zero or more valid objects within the current instance document when encoded as RDF." ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/fix-protocol/string> a linkml:TypeDefinition ;
	skos:editorialNote "In RDF serializations, a slot with range of string is treated as a literal or type xsd:string. If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"string\"." ;
	skos:exactMatch "schema:Text"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/linkml/String"^^xsd:anyURI ;
	linkml:description "A character string" ;
	linkml:imported_from "linkml:types" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/fix-protocol/time> a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"time\"." , "URI is dateTime because OWL reasoners do not work with straight date or time" ;
	skos:exactMatch "schema:Time"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "XSDTime" ;
	linkml:definition_uri "https://w3id.org/linkml/Time"^^xsd:anyURI ;
	linkml:description "A time object represents a (local) time of day, independent of any particular day" ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
